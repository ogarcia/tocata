#!/usr/bin/env bash
# Pre-commit hook: blocks commits whose staged code is not formatted
# or fails clippy. `cargo test` is intentionally NOT run here —
# tests are CI's job; the hook keeps the local feedback loop fast.
#
# Activate once per clone:
#   git config core.hooksPath .githooks

set -euo pipefail

if ! cargo fmt --all -- --check; then
    echo
    echo "✗ rustfmt found unformatted code. Run: cargo fmt --all" >&2
    exit 1
fi

# `--workspace` is not decoration. The workspace sets
# `default-members = ["server"]`, so without it clippy never looks at the panel at
# all — and a lint in the panel sailed through this hook and failed on CI, which is
# the one thing the hook exists to stop. Keep this line identical to the CI's.
if ! cargo clippy --workspace --all-targets --all-features -- -D warnings; then
    echo
    echo "✗ clippy reported warnings. Fix them before committing." >&2
    exit 1
fi
